tization by exploiting five missing rawtext elements (noscript, xmp, noembed, noframes, iframe) in the SAFE_FOR_XML regex. Attackers can include payloads like </noscript><img src=x onerror=alert(1)> in attribute values to execute JavaScript when sanitized output is placed inside these unprotected rawtext contexts.","cvss":[{"source":"help@fluidattacks.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:P/VC:N/VI:N/VA:N/SC:L/SI:L/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":5.3},"vendorMetadata":{}},{"source":"help@fluidattacks.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":2.9,"impactScore":2.8},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-0540","epss":0.00284,"percentile":0.19916,"date":"2026-06-23"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"dompurify","version":"3.2.7"}},"found":{"vulnerabilityID":"GHSA-v2wj-7wpq-c8vv","versionConstraint":">=3.1.3,<=3.3.1 (semantic)"},"fix":{"suggestedVersion":"3.3.2"}}],"artifact":{"id":"Package-npm-dompurify-307066efc77c132b","name":"dompurify","version":"3.2.7","type":"npm","locations":null,"language":"javascript","licenses":["(MPL-2.0 OR Apache-2.0)"],"cpes":["cpe:2.3:a:dompurify:dompurify:3.2.7:*:*:*:*:*:*:*"],"purl":"pkg:npm/dompurify@3.2.7","upstreams":[]}},{"vulnerability":{"id":"GHSA-h7mw-gpvr-xq4m","dataSource":"https://github.com/advisories/GHSA-h7mw-gpvr-xq4m","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/security/advisories/GHSA-h7mw-gpvr-xq4m","https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://nvd.nist.gov/vuln/detail/CVE-2026-41240","https://github.com/cure53/DOMPurify/commit/c361baa18dbdcb3344a41110f4c48ad85bf48f80"],"description":"DOMPurify: FORBID_TAGS bypassed by function-based ADD_TAGS predicate (asymmetry with FORBID_ATTR fix)","cvss":[{"type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:P/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N","metrics":{"baseScore":6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41240","epss":0.00263,"percentile":0.17508,"date":"2026-06-23"}],"fix":{"versions":["3.4.0"],"state":"fixed","available":[{"version":"3.4.0","date":"2026-04-23","kind":"first-observed"}]},"advisories":[],"risk":0.14465},"relatedVulnerabilities":[{"id":"CVE-2026-41240","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-41240","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/commit/c361baa18dbdcb3344a41110f4c48ad85bf48f80","https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://github.com/cure53/DOMPurify/security/advisories/GHSA-h7mw-gpvr-xq4m"],"description":"DOMPurify is a DOM-only cross-site scripting sanitizer for HTML, MathML, and SVG. Versions prior to 3.4.0 have an inconsistency between FORBID_TAGS and FORBID_ATTR handling when function-based ADD_TAGS is used. Commit c361baa added an early exit for FORBID_ATTR at line 1214. The same fix was not applied to FORBID_TAGS. At line 1118-1123, when EXTRA_ELEMENT_HANDLING.tagCheck returns true, the short-circuit evaluation skips the FORBID_TAGS check entirely. This allows forbidden elements to survive sanitization with their attributes intact. Version 3.4.0 patches the issue.","cvss":[{"source":"nvd@nist.gov","type":"Primary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":2.9,"impactScore":2.8},"vendorMetadata":{}},{"source":"security-advisories@github.com","type":"Secondary","version":"4.0","vector":"CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:P/VC:N/VI:H/VA:N/SC:N/SI:N/SA:N/E:X/CR:X/IR:X/AR:X/MAV:X/MAC:X/MAT:X/MPR:X/MUI:X/MVC:X/MVI:X/MVA:X/MSC:X/MSI:X/MSA:X/S:X/AU:X/R:X/V:X/RE:X/U:X","metrics":{"baseScore":6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41240","epss":0.00263,"percentile":0.17508,"date":"2026-06-23"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"dompurify","version":"3.2.7"}},"found":{"vulnerabilityID":"GHSA-h7mw-gpvr-xq4m","versionConstraint":"<3.4.0 (semantic)"},"fix":{"suggestedVersion":"3.4.0"}}],"artifact":{"id":"Package-npm-dompurify-307066efc77c132b","name":"dompurify","version":"3.2.7","type":"npm","locations":null,"language":"javascript","licenses":["(MPL-2.0 OR Apache-2.0)"],"cpes":["cpe:2.3:a:dompurify:dompurify:3.2.7:*:*:*:*:*:*:*"],"purl":"pkg:npm/dompurify@3.2.7","upstreams":[]}},{"vulnerability":{"id":"GHSA-crv5-9vww-q3g8","dataSource":"https://github.com/advisories/GHSA-crv5-9vww-q3g8","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/security/advisories/GHSA-crv5-9vww-q3g8","https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://nvd.nist.gov/vuln/detail/CVE-2026-41239"],"description":"DOMPurify has a SAFE_FOR_TEMPLATES bypass in RETURN_DOM mode","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:N","metrics":{"baseScore":6.8,"exploitabilityScore":1.7,"impactScore":5.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41239","epss":0.00217,"percentile":0.11895,"date":"2026-06-23"}],"fix":{"versions":["3.4.0"],"state":"fixed","available":[{"version":"3.4.0","date":"2026-04-23","kind":"first-observed"}]},"advisories":[],"risk":0.12803},"relatedVulnerabilities":[{"id":"CVE-2026-41239","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-41239","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://github.com/cure53/DOMPurify/security/advisories/GHSA-crv5-9vww-q3g8"],"description":"DOMPurify is a DOM-only cross-site scripting sanitizer for HTML, MathML, and SVG. Starting in version 1.0.10 and prior to version 3.4.0, `SAFE_FOR_TEMPLATES` strips `{{...}}` expressions from untrusted HTML. This works in string mode but not with `RETURN_DOM` or `RETURN_DOM_FRAGMENT`, allowing XSS via template-evaluating frameworks like Vue 2. Version 3.4.0 patches the issue.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:U/C:H/I:H/A:N","metrics":{"baseScore":6.8,"exploitabilityScore":1.7,"impactScore":5.2},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41239","epss":0.00217,"percentile":0.11895,"date":"2026-06-23"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"dompurify","version":"3.2.7"}},"found":{"vulnerabilityID":"GHSA-crv5-9vww-q3g8","versionConstraint":">=1.0.10,<3.4.0 (semantic)"},"fix":{"suggestedVersion":"3.4.0"}}],"artifact":{"id":"Package-npm-dompurify-307066efc77c132b","name":"dompurify","version":"3.2.7","type":"npm","locations":null,"language":"javascript","licenses":["(MPL-2.0 OR Apache-2.0)"],"cpes":["cpe:2.3:a:dompurify:dompurify:3.2.7:*:*:*:*:*:*:*"],"purl":"pkg:npm/dompurify@3.2.7","upstreams":[]}},{"vulnerability":{"id":"GHSA-v9jr-rg53-9pgp","dataSource":"https://github.com/advisories/GHSA-v9jr-rg53-9pgp","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/security/advisories/GHSA-v9jr-rg53-9pgp","https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://nvd.nist.gov/vuln/detail/CVE-2026-41238"],"description":"DOMPurify: Prototype Pollution to XSS Bypass via CUSTOM_ELEMENT_HANDLING Fallback","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:C/C:H/I:L/A:N","metrics":{"baseScore":6.9,"exploitabilityScore":1.7,"impactScore":4.8},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41238","epss":0.00205,"percentile":0.10481,"date":"2026-06-23"}],"fix":{"versions":["3.4.0"],"state":"fixed","available":[{"version":"3.4.0","date":"2026-04-23","kind":"first-observed"}]},"advisories":[],"risk":0.12197500000000001},"relatedVulnerabilities":[{"id":"CVE-2026-41238","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-41238","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/cure53/DOMPurify/releases/tag/3.4.0","https://github.com/cure53/DOMPurify/security/advisories/GHSA-v9jr-rg53-9pgp"],"description":"DOMPurify is a DOM-only cross-site scripting sanitizer for HTML, MathML, and SVG. Versions 3.0.1 through 3.3.3 are vulnerable to a prototype pollution-based XSS bypass. When an application uses `DOMPurify.sanitize()` with the default configuration (no `CUSTOM_ELEMENT_HANDLING` option), a prior prototype pollution gadget can inject permissive `tagNameCheck` and `attributeNameCheck` regex values into `Object.prototype`, causing DOMPurify to allow arbitrary custom elements with arbitrary attributes — including event handlers — through sanitization. Version 3.4.0 fixes the issue.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:H/PR:N/UI:R/S:C/C:H/I:L/A:N","metrics":{"baseScore":6.9,"exploitabilityScore":1.7,"impactScore":4.8},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41238","epss":0.00205,"percentile":0.10481,"date":"2026-06-23"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"dompurify","version":"3.2.7"}},"found":{"vulnerabilityID":"GHSA-v9jr-rg53-9pgp","versionConstraint":">=3.0.1,<3.4.0 (semantic)"},"fix":{"suggestedVersion":"3.4.0"}}],"artifact":{"id":"Package-npm-dompurify-307066efc77c132b","name":"dompurify","version":"3.2.7","type":"npm","locations":null,"language":"javascript","licenses":["(MPL-2.0 OR Apache-2.0)"],"cpes":["cpe:2.3:a:dompurify:dompurify:3.2.7:*:*:*:*:*:*:*"],"purl":"pkg:npm/dompurify@3.2.7","upstreams":[]}},{"vulnerability":{"id":"GHSA-qx2v-qp2m-jg93","dataSource":"https://github.com/advisories/GHSA-qx2v-qp2m-jg93","namespace":"github:language:javascript","severity":"Medium","urls":["https://github.com/postcss/postcss/security/advisories/GHSA-qx2v-qp2m-jg93","https://nvd.nist.gov/vuln/detail/CVE-2026-41305","https://github.com/postcss/postcss/releases/tag/8.5.10"],"description":"PostCSS has XSS via Unescaped </style> in its CSS Stringify Output","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":2.9,"impactScore":2.8},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-41305","epss":0.00205,"percentile":0.10432,"date":"2026-06-23"}],"fix":{"versions":["8.5.10"],"state":"fixed","available":[{"version":"8.5.10","date":"2026-04-24","kind":"first-observed"}]},"advisories":[],"risk":0.11377499999999999},"relatedVulnerabilities":[{"id":"CVE-2026-41305","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-41305","namespace":"nvd:cpe","severity":"Medium","urls":["https://github.com/postcss/postcss/releases/tag/8.5.10","https://github.com/postcss/postcss/security/advisories/GHSA-qx2v-qp2m-jg93"],"description":"PostCSS takes a CSS file and provides an API to analyze and modify its rules by transforming the rules into an Abstract Syntax Tree. Versions prior to 8.5.10 do not escape `</style>` sequences when stringifying CSS ASTs. When user-submitted CSS is parsed and re-stringified for embedding in HTML `<style>` tags, `</style>` in CSS values breaks out of the style context, enabling XSS. Version 8.5.10 fixes the issue.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","metrics":{"baseScore":6.1,"exploitabilityScore":2.9,"impactScore":2.8},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-4130